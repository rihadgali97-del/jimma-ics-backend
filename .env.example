# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# --- Database (MySQL) ---
# Match whatever user/password/db you created in MySQL Workbench (step 5)
DATABASE_URL="mysql://jimma_ics:!@localhost:3306/jimma_ics"

# --- JWT ---
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# twice and paste each result below (must be at least 32 chars)
JWT_ACCESS_SECRET="PASTE_FIRST_GENERATED_SECRET_HERE"
JWT_REFRESH_SECRET="PASTE_SECOND_GENERATED_SECRET_HERE"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Council document archive (server-side only) ---
CLOUDINARY_CLOUD_NAME=Jimma
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_COUNCIL_DOCUMENTS_FOLDER=jic
CLOUDINARY_URL=

# --- Logging ---
LOG_LEVEL=info

# --- Notifications (configure providers before enabling delivery) ---
# Gmail SMTP (classic App Password) path:
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
# Gmail API over HTTPS (OAuth 2.0; avoids SMTP port 587):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_OAUTH2_USER=
EMAIL_FROM_ADDRESS=Jimma Islamic Council <info@jimmaislamiccouncil.org>
WEB_APP_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@riho_information
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jimmaislamiccouncil.org

# --- Seed script only ---
SEED_SUPER_ADMIN_EMAIL=admin@jimmaislamiccouncil.org
SEED_SUPER_ADMIN_PASSWORD=